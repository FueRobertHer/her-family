{
  "name": "her-family",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --remote",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --ext .js,.ts,.astro --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{js,ts,astro,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,astro,json,md}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/db": "^0.19.0",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.0.4",
    "@libsql/client": "^0.17.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^1.6.1",
    "astro": "^5.16.15",
    "cloudinary": "^2.9.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.19.0",
    "eslint-plugin-astro": "^1.3.3",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1"
