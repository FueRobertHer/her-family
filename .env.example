# Cloudinary Configuration (Required for image uploads)
# Sign up at https://cloudinary.com for a free account
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Database Configuration (Required)
# Turso database URL and authentication token
# Get these from https://turso.tech after creating a database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Astro DB Configuration (Required - same as Turso credentials)
# These are used by the Astro DB integration
ASTRO_DB_REMOTE_URL=libsql://your-database.turso.io
ASTRO_DB_APP_TOKEN=your_turso_auth_token_here

# Admin Configuration (Required)
# Set a strong password for admin access
# This password is used to access /admin and moderate comments
ADMIN_PASSWORD=your_secure_admin_password_here

# Session signing secret (Recommended)
# Used to sign admin session cookies (HMAC-SHA256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a secret is derived from ADMIN_PASSWORD instead.
SESSION_SECRET=your_random_session_secret_here

# Optional: Node Environment
# NODE_ENV=production
