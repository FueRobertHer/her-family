---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import AdminToolbar from '../components/AdminToolbar.astro';
import AdminModalShell from '../components/AdminModalShell.astro';
import { MemorialService } from '../lib/services/memorial.service.ts';
import { isAuthenticated } from '../lib/auth';
import { embedJson } from '../lib/embed-json';

const isAdmin = isAuthenticated(Astro.cookies);
const activeMemorials = await MemorialService.getActiveMemorials();
const defaultMemorial = activeMemorials[0];
const memorialSlug = defaultMemorial?.slug || '';

let homeContent: Record<string, string> = {};
if (defaultMemorial) {
  homeContent = await MemorialService.getMemorialContent(defaultMemorial.id, 'home');
}

const getContent = (key: string, fallback: string) => homeContent[key] ?? fallback;
// Eyebrow and title used to both default to "Welcome", reading like a bug.
const homeEyebrow = getContent('eyebrow', 'In Loving Memory');
const homeTitle = getContent('title', 'Welcome');
const homeDescription = getContent(
  'description',
  'A quiet space to remember, reflect, and celebrate the lives that shaped our family.'
);
---

<Layout title={homeTitle} description="A place to honor and remember loved ones.">
  <main class="relative overflow-hidden min-h-[calc(100vh-3.5rem)] bg-warm-gray-50 flex items-start">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(99,102,241,0.10),transparent_55%)]"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-20 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-white/60 blur-3xl"
    ></div>

    {isAdmin && memorialSlug && (
      <AdminToolbar
        toolbarId="homeAdminToolbar"
        contentId="homeAdminToolbarContent"
        controlsId="homeAdminToolbarControls"
        draggable={true}
        showMinimize={true}
        minimizeButtonId="homeMinimizeToolbarBtn"
      >
        <button
          id="openHomeEditor"
          class="text-xs bg-white/20 hover:bg-white/30 px-2 py-1 rounded-sm transition-colors"
        >
          Edit Home
        </button>
      </AdminToolbar>
    )}

    <section
      transition:name="home-hero"
      class="relative z-10 w-full max-w-4xl mx-auto px-6 pt-28 sm:pt-32 pb-24 text-center"
    >
      <p
        id="homeEyebrow"
        class="home-fade-1 text-xs sm:text-sm uppercase tracking-[0.14em] text-warm-gray-500"
      >
        {homeEyebrow}
      </p>
      <h1
        id="homeTitle"
        class="home-fade-2 mt-5 font-display text-5xl sm:text-6xl leading-tight text-warm-gray-900"
      >
        {homeTitle}
      </h1>
      <p
        id="homeDescription"
        class="home-fade-3 mt-7 max-w-2xl mx-auto text-lg leading-8 text-warm-gray-600"
      >
        {homeDescription}
      </p>
      <div class="home-fade-3 mt-9 mx-auto h-px w-28 bg-linear-to-r from-transparent via-warm-gray-300 to-transparent"></div>

      {activeMemorials.length > 0 && (
        <div class="home-fade-3 mt-12 text-left">
          <div class="grid gap-6 sm:grid-cols-2">
            {activeMemorials.map((memorial) => (
              <a
                href={`/memorials/${memorial.slug}`}
                transition:name={`memorial-card-${memorial.slug}`}
                class="block bg-white border border-warm-gray-200 rounded-xl p-6 hover:shadow-md transition-shadow"
              >
                <h2 class="text-xl font-semibold text-warm-gray-900">{memorial.name}</h2>
                <p class="mt-2 text-sm text-warm-gray-500">Open memorial</p>
              </a>
            ))}
          </div>
          <div class="mt-8 text-center">
            <a
              href="/memorials"
              class="inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm font-medium text-warm-gray-700 hover:bg-warm-gray-100 transition-colors"
            >
              View all memorials
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      )}
    </section>
  </main>

  {isAdmin && memorialSlug && (
    <>
      <script
        id="home-editor-data"
        type="application/json"
        is:inline
        set:html={embedJson({ memorialSlug, homeEyebrow, homeTitle, homeDescription })}
      />
      <AdminModalShell
        modalId="homeEditorModal"
        title="Edit Home Content"
        closeButtonId="closeHomeEditor"
        cancelButtonId="cancelHomeEditor"
        saveButtonId="saveHomeEditor"
        saveLabel="Save"
      >
        <div>
          <label for="home-eyebrow-input" class="block text-sm font-medium text-gray-700 mb-2">Top Label</label>
          <input id="home-eyebrow-input" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-gray-900" />
        </div>
        <div>
          <label for="home-title-input" class="block text-sm font-medium text-gray-700 mb-2">Title</label>
          <input id="home-title-input" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-gray-900" />
        </div>
        <div>
          <label for="home-description-input" class="block text-sm font-medium text-gray-700 mb-2">Description</label>
          <textarea id="home-description-input" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white text-gray-900"></textarea>
        </div>
        <p id="homeEditorMessage" class="text-sm hidden"></p>
      </AdminModalShell>

      <script>
        import '../scripts/home-editor.ts';
      </script>
    </>
  )}
</Layout>

<style>
  .home-fade-1,
  .home-fade-2,
  .home-fade-3 {
    animation: homeFadeIn 520ms ease-out both;
  }

  .home-fade-2 {
    animation-delay: 80ms;
  }

  .home-fade-3 {
    animation-delay: 160ms;
  }

  @keyframes homeFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-fade-1,
    .home-fade-2,
    .home-fade-3 {
      animation: none;
    }
  }
</style>
