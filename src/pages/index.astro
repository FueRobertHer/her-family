---
// @ts-nocheck
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { db, Memorials, eq } from 'astro:db';

const memorials = await db.select().from(Memorials).where(eq(Memorials.status, 'active'));
const featuredMemorial = memorials[0];
---

<Layout title="Her Family" description="Family hub for updates, memorials, and shared moments">
  <main class="min-h-screen bg-warm-gray-50">
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-12">
      <p class="text-sm uppercase tracking-[0.18em] text-warm-gray-500">Her Family</p>
      <h1 class="mt-3 font-display text-4xl sm:text-5xl text-warm-gray-900">Family Hub</h1>
      <p class="mt-6 max-w-2xl text-lg text-warm-gray-600">
        A shared home for family updates, important dates, resources, and memorials.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/memorials"
          class="px-5 py-3 rounded-lg bg-warm-gray-800 text-white hover:bg-warm-gray-700 transition-colors"
        >
          Browse Memorials
        </a>
        {featuredMemorial && (
          <a
            href={`/memorials/${featuredMemorial.slug}`}
            class="px-5 py-3 rounded-lg border border-warm-gray-300 text-warm-gray-700 hover:bg-white transition-colors"
          >
            Open Featured Memorial
          </a>
        )}
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/memorials" class="bg-white border border-warm-gray-200 rounded-xl p-6 hover:shadow-md">
          <h2 class="text-xl font-semibold text-warm-gray-900">Memorials</h2>
          <p class="mt-2 text-warm-gray-600 text-sm">
            Visit and manage memorial pages for loved ones.
          </p>
        </a>
        <div class="bg-white border border-warm-gray-200 rounded-xl p-6">
          <h2 class="text-xl font-semibold text-warm-gray-900">Events</h2>
          <p class="mt-2 text-warm-gray-600 text-sm">
            Coming soon: shared family calendar and service events.
          </p>
        </div>
        <div class="bg-white border border-warm-gray-200 rounded-xl p-6">
          <h2 class="text-xl font-semibold text-warm-gray-900">Resources</h2>
          <p class="mt-2 text-warm-gray-600 text-sm">
            Coming soon: documents, links, and support information.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
