---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you're looking for cannot be found.">
  <main class="min-h-screen flex items-center justify-center px-4 py-16">
    <div class="max-w-2xl w-full text-center">
      <!-- 404 Number -->
      <h1 class="font-display text-8xl md:text-9xl font-bold text-warm-gray-300 mb-4">
        404
      </h1>
      
      <!-- Message -->
      <h2 class="font-display text-3xl md:text-4xl font-semibold text-warm-gray-900 mb-4">
        Page Not Found
      </h2>
      
      <p class="text-lg text-warm-gray-600 mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>
      
      <!-- Home Button -->
      <a 
        href="/" 
        class="inline-flex items-center justify-center px-8 py-4 bg-warm-gray-800 hover:bg-warm-gray-700 text-white font-medium rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        Return Home
      </a>
      
      <!-- Decorative Element -->
      <div class="mt-16 opacity-20">
        <svg class="w-24 h-24 mx-auto text-warm-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
    </div>
  </main>
</Layout>
