---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { db, MemorialContent, eq, and } from 'astro:db';

const { id } = Astro.params;
const serviceIndex = parseInt(id || '0');

// Fetch the service data specifically
const result = await db.select()
  .from(MemorialContent)
  .where(
    and(
      eq(MemorialContent.section, 'funeral'),
      eq(MemorialContent.key, `service${serviceIndex}`)
    )
  )
  .get();

let agendaUrl = null;
let serviceType = "Service";

if (result && result.value) {
  try {
    const serviceData = JSON.parse(result.value);
    agendaUrl = serviceData.agendaUrl;
    serviceType = serviceData.type || "Service";
    console.log('Service data:', { agendaUrl, serviceType, result: result.value });
  } catch (e) {
    console.error('Error parsing service data', e);
  }
}

if (!agendaUrl) {
  console.error('No agenda URL found, redirecting');
  return Astro.redirect('/#funeral-info');
}

// Check if it's a PDF or an image
const urlLower = agendaUrl.toLowerCase();
const isImage = urlLower.includes('.jpg') || 
                urlLower.includes('.jpeg') || 
                urlLower.includes('.png') || 
                urlLower.includes('.gif') || 
                urlLower.includes('.webp') ||
                urlLower.includes('/image/upload/');

// It's a PDF if it explicitly has .pdf or is a raw upload (and not an image)
const isPdf = (urlLower.includes('.pdf') || urlLower.includes('/raw/upload/')) && !isImage;

console.log('Agenda check:', { agendaUrl, isPdf, isImage, urlLower });

// Helper to construct download URL for Cloudinary
const getDownloadUrl = (url: string) => {
  if (!url || !url.includes('/upload/')) return url;
  return url.replace('/upload/', '/upload/fl_attachment/');
};

const downloadUrl = getDownloadUrl(agendaUrl);
---

<Layout title={`${serviceType} Agenda`} description="View service agenda">
  <div class="min-h-screen bg-warm-gray-100 flex flex-col">
    <!-- Header -->
    <div class="bg-warm-gray-50 border-b border-warm-gray-200 px-3 py-3 sm:px-4 sm:py-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex justify-between items-center gap-2 sm:gap-3">
          <h1 class="text-sm sm:text-lg md:text-xl font-semibold text-warm-gray-900 truncate">{serviceType} Agenda</h1>
          <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
            {(isPdf || isImage) && (
              <a href={isPdf ? downloadUrl : agendaUrl} download class="inline-flex items-center px-2 py-1.5 sm:px-3 sm:py-2 border border-warm-gray-300 shadow-sm text-xs sm:text-sm font-medium rounded-lg text-warm-gray-700 bg-white hover:bg-warm-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors whitespace-nowrap">
                Download
              </a>
            )}
            <a href="/#funeral-info" class="inline-flex items-center text-indigo-600 hover:text-indigo-800 text-xs sm:text-sm font-medium transition-colors whitespace-nowrap">
              <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-0.5 sm:mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
              Back
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Content Viewer -->
    <div class="flex-1 p-3 sm:p-6 flex justify-center items-start">
      {isPdf ? (
        <div class="w-full max-w-5xl h-[calc(100vh-120px)] sm:h-[85vh] bg-white border border-warm-gray-200 rounded-lg shadow-md overflow-hidden relative">
          <iframe
            id="pdf-viewer"
            src={`https://docs.google.com/viewer?url=${encodeURIComponent(agendaUrl)}&embedded=true`}
            title={`${serviceType} Agenda PDF`}
            class="w-full h-full"
            style="border: none;"
          ></iframe>
          
          <!-- Loading message -->
          <div id="pdf-loading" class="absolute inset-0 flex flex-col items-center justify-center bg-warm-gray-50">
            <svg class="animate-spin h-12 w-12 text-indigo-600 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="text-warm-gray-600">Loading PDF...</p>
          </div>

          <!-- Error fallback -->
          <div id="pdf-error" class="absolute inset-0 hidden flex-col items-center justify-center bg-warm-gray-50 p-8">
            <svg class="w-16 h-16 text-warm-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
            <p class="text-lg text-warm-gray-900 font-medium mb-2">Unable to Display PDF</p>
            <p class="text-warm-gray-600 mb-4 text-center text-sm">The PDF viewer couldn't load. Please download or open in a new tab.</p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a 
                href={downloadUrl} 
                download
                class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
              >
                Download Agenda
              </a>
              <button 
                onclick={`window.open('${agendaUrl}', '_blank')`}
                class="inline-flex items-center justify-center px-4 py-2 border border-warm-gray-300 shadow-sm text-sm font-medium rounded-lg text-warm-gray-700 bg-white hover:bg-warm-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
              >
                Open in New Tab
              </button>
              <button 
                id="try-native-viewer"
                class="inline-flex items-center justify-center px-4 py-2 border border-warm-gray-300 shadow-sm text-sm font-medium rounded-lg text-warm-gray-700 bg-white hover:bg-warm-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
              >
                Try Native Viewer
              </button>
            </div>
          </div>
        </div>
      ) : (
        <div class="w-full max-w-5xl flex justify-center">
          <img 
            src={agendaUrl} 
            alt={`${serviceType} Information`}
            class="max-w-full max-h-[calc(100vh-120px)] sm:max-h-[85vh] object-contain rounded-lg shadow-md border border-warm-gray-200" 
          />
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  // Handle PDF iframe loading
  const iframe = document.getElementById('pdf-viewer') as HTMLIFrameElement;
  const loading = document.getElementById('pdf-loading');
  const error = document.getElementById('pdf-error');
  const tryNativeBtn = document.getElementById('try-native-viewer');
  const originalUrl = iframe?.src.match(/url=([^&]+)/)?.[1];
  const decodedUrl = originalUrl ? decodeURIComponent(originalUrl) : '';
  
  if (iframe && loading) {
    let loadTimeout: number;
    let hasLoaded = false;
    
    // Hide loading after iframe loads
    iframe.addEventListener('load', () => {
      clearTimeout(loadTimeout);
      hasLoaded = true;
      if (loading) {
        loading.style.display = 'none';
      }
    });
    
    // Show error if loading takes too long (20 seconds for Google viewer)
    loadTimeout = window.setTimeout(() => {
      if (!hasLoaded && loading && error) {
        loading.style.display = 'none';
        error.style.display = 'flex';
      }
    }, 20000);
    
    // Handle iframe errors
    iframe.addEventListener('error', () => {
      clearTimeout(loadTimeout);
      if (loading && error) {
        loading.style.display = 'none';
        error.style.display = 'flex';
      }
    });
    
    // Try native viewer as fallback
    if (tryNativeBtn && decodedUrl) {
      tryNativeBtn.addEventListener('click', () => {
        iframe.src = decodedUrl;
        
        if (error) error.style.display = 'none';
        if (loading) loading.style.display = 'flex';
        
        // Shorter timeout for native viewer
        setTimeout(() => {
          if (loading && error) {
            loading.style.display = 'none';
            error.style.display = 'flex';
          }
        }, 10000);
      });
    }
  }
</script>
