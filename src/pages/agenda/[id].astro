---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { db, MemorialContent, eq, and } from 'astro:db';

const { id } = Astro.params;
const serviceIndex = parseInt(id || '0');

// Fetch the service data specifically
const result = await db.select()
  .from(MemorialContent)
  .where(
    and(
      eq(MemorialContent.section, 'funeral'),
      eq(MemorialContent.key, `service${serviceIndex}`)
    )
  )
  .get();

let agendaUrl = null;
let serviceType = "Service";

if (result && result.value) {
  try {
    const serviceData = JSON.parse(result.value);
    agendaUrl = serviceData.agendaUrl;
    serviceType = serviceData.type || "Service";
    console.log('Service data:', { agendaUrl, serviceType, result: result.value });
  } catch (e) {
    console.error('Error parsing service data', e);
  }
}

if (!agendaUrl) {
  console.error('No agenda URL found, redirecting');
  return Astro.redirect('/#funeral-info');
}

// Check if it's a PDF or an image
const urlLower = agendaUrl.toLowerCase();
const isImage = urlLower.includes('.jpg') || 
                urlLower.includes('.jpeg') || 
                urlLower.includes('.png') || 
                urlLower.includes('.gif') || 
                urlLower.includes('.webp') ||
                urlLower.includes('/image/upload/');

// It's a PDF if it explicitly has .pdf or is a raw upload (and not an image)
const isPdf = (urlLower.includes('.pdf') || urlLower.includes('/raw/upload/')) && !isImage;

console.log('Agenda check:', { agendaUrl, isPdf, isImage, urlLower });

// Helper to construct download URL for Cloudinary
const getDownloadUrl = (url: string) => {
  if (!url || !url.includes('/upload/')) return url;
  return url.replace('/upload/', '/upload/fl_attachment/');
};

const downloadUrl = getDownloadUrl(agendaUrl);
---

<Layout title={`${serviceType} Agenda`} description="View service agenda">
  <div class="min-h-screen bg-warm-gray-50 flex flex-col">
    <!-- Header -->
    <div class="bg-white shadow-sm p-4 flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <h1 class="text-lg font-semibold text-gray-900">{serviceType} {isPdf ? 'Agenda' : 'Information'}</h1>
        {(isPdf || isImage) && (
           <a href={isPdf ? downloadUrl : agendaUrl} download class="inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-sm font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Download Agenda
          </a>
        )}
      </div>
      <a href="/#funeral-info" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center">
        &larr; Back to Memorial
      </a>
    </div>

    <!-- Content Viewer -->
    <div class="flex-1 p-4 flex justify-center items-start">
      {isPdf ? (
        <div class="w-full max-w-5xl h-[85vh] bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden relative">
          <iframe
            id="pdf-viewer"
            src={`https://docs.google.com/viewer?url=${encodeURIComponent(agendaUrl)}&embedded=true`}
            title={`${serviceType} Agenda PDF`}
            class="w-full h-full"
            style="border: none;"
          ></iframe>
          
          <!-- Loading message -->
          <div id="pdf-loading" class="absolute inset-0 flex flex-col items-center justify-center bg-white">
            <svg class="animate-spin h-12 w-12 text-indigo-600 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="text-gray-600">Loading PDF...</p>
          </div>

          <!-- Error fallback -->
          <div id="pdf-error" class="absolute inset-0 hidden flex-col items-center justify-center bg-gray-50 p-8">
            <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
            <p class="text-lg text-gray-900 font-medium mb-2">Unable to Display Document</p>
            <p class="text-gray-500 mb-6 text-center">Your browser may not support the embedded viewer or it is blocked.</p>
            <a 
              href={downloadUrl} 
              download
              class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
            >
              Download Agenda
            </a>
            <button 
              onclick={`window.open('${agendaUrl}', '_blank')`}
              class="mt-3 inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
            >
              Open in New Tab
            </button>
          </div>
        </div>
      ) : (
        <div class="w-full max-w-5xl flex justify-center">
          <img 
            src={agendaUrl} 
            alt={`${serviceType} Information`}
            class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-lg" 
          />
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  // Handle PDF iframe loading
  const iframe = document.getElementById('pdf-viewer');
  const loading = document.getElementById('pdf-loading');
  const error = document.getElementById('pdf-error');
  
  if (iframe && loading) {
    let loadTimeout: number;
    
    // Hide loading after iframe loads
    iframe.addEventListener('load', () => {
      clearTimeout(loadTimeout);
      if (loading) {
        loading.style.display = 'none';
      }
    });
    
    // Show error if loading takes too long (30 seconds)
    loadTimeout = window.setTimeout(() => {
      if (loading && error) {
        loading.style.display = 'none';
        error.style.display = 'flex';
      }
    }, 30000);
    
    // Handle iframe errors
    iframe.addEventListener('error', () => {
      clearTimeout(loadTimeout);
      if (loading && error) {
        loading.style.display = 'none';
        error.style.display = 'flex';
      }
    });
  }
</script>
