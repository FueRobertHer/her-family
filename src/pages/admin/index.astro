---
export const prerender = false;

// Check for authentication
const cookies = Astro.cookies;
const authCookie = cookies.get('admin_auth');
const isAuthenticated = authCookie?.value === 'true';

// Handle logout
if (Astro.url.searchParams.get('logout') === 'true') {
  cookies.delete('admin_auth');
  return Astro.redirect('/admin');
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Memorial Page</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; }
  </style>
</head>
<body class="bg-gray-50">

{!isAuthenticated ? (
  <div class="min-h-screen flex items-center justify-center">
    {/* Login Form */}
    <div class="max-w-md w-full space-y-8">
      <div>
        <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
          Admin Access
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
          Enter password to manage comments
        </p>
      </div>
      <form id="loginForm" class="mt-8 space-y-6">
        <div>
          <label for="password" class="sr-only">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
            placeholder="Admin password"
          />
        </div>
        <div id="loginError" class="text-red-600 text-sm text-center hidden"></div>
        <div>
          <button
            type="submit"
            id="loginButton"
            class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50"
          >
            Sign in
          </button>
        </div>
      </form>

      <script>
        // Handle login form submission
        const loginForm = document.getElementById('loginForm');
        if (loginForm) {
          loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const passwordInput = document.getElementById('password') as HTMLInputElement | null;
            const loginButton = document.getElementById('loginButton') as HTMLButtonElement | null;
            const loginError = document.getElementById('loginError');
            
            if (!passwordInput || !loginButton || !loginError) return;
            
            const password = passwordInput.value;
            
            // Reset error state
            loginError.classList.add('hidden');
            loginButton.disabled = true;
            loginButton.textContent = 'Signing in...';
            
            try {
              const response = await fetch('/api/admin/login', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({ password })
              });
              
              const result = await response.json();
              
              if (result.success) {
                // Show success message briefly before redirect
                loginError.textContent = 'Login successful! Checking authentication...';
                loginError.classList.remove('hidden');
                loginError.classList.remove('text-red-600');
                loginError.classList.add('text-green-600');
                
                // Redirect after a brief delay
                setTimeout(() => {
                  window.location.reload(); // Use reload instead of href to ensure fresh page load
                }, 1500);
              } else {
                loginError.textContent = result.error || 'Login failed';
                loginError.classList.remove('hidden');
              }
            } catch (error) {
              console.error('Login error:', error);
              loginError.textContent = 'Login failed. Please try again.';
              loginError.classList.remove('hidden');
            } finally {
              loginButton.disabled = false;
              loginButton.textContent = 'Sign in';
            }
          });
        }
      </script>
    </div>
  </div>
) : (
  <div class="min-h-screen bg-gray-50">
    {/* Admin Dashboard */}
    <header class="bg-white shadow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">The Her Family Admin</h1>
          </div>
          <div class="flex items-center space-x-4">
            <a href="/" class="text-indigo-600 hover:text-indigo-900 font-medium">✏️ Edit Content</a>
            <a href="/admin?logout=true" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700">
              Logout
            </a>
          </div>
        </div>
      </div>
    </header>
    {/* Main Content */}
    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
      {/* Filter Tabs */}
      <div class="bg-white shadow rounded-lg mb-6">
        <div class="border-b border-gray-200">
          <nav class="-mb-px flex space-x-8 px-6 overflow-x-auto" aria-label="Tabs">
            <button
              class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center"
              data-tab="pending"
            >
              Pending Review
              <span id="pendingCount" class="ml-2 bg-yellow-100 text-yellow-800 py-0.5 px-2 rounded-full text-xs">0</span>
            </button>
            <button
              class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center"
              data-tab="approved"
            >
              Approved
              <span id="approvedCount" class="ml-2 bg-green-100 text-green-800 py-0.5 px-2 rounded-full text-xs">0</span>
            </button>
            <button
              class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center"
              data-tab="rejected"
            >
              Rejected
              <span id="rejectedCount" class="ml-2 bg-red-100 text-red-800 py-0.5 px-2 rounded-full text-xs">0</span>
            </button>
            <button
              class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center"
              data-tab="all"
            >
              All Comments
              <span id="totalCount" class="ml-2 bg-gray-100 text-gray-800 py-0.5 px-2 rounded-full text-xs">0</span>
            </button>
          </nav>
        </div>
      </div>
      {/* Comments List */}
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900" id="sectionTitle">
            Loading comments...
          </h3>
        </div>
        <div id="commentsContainer" class="divide-y divide-gray-200">
          {/* Comments will be loaded here */}
          <div class="p-6 text-center">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600 mx-auto"></div>
            <p class="text-gray-600 mt-2">Loading comments...</p>
          </div>
        </div>
      </div>
    </main>
  </div>
)}

<script>
  // Global type declarations
  declare global {
    interface Window {
      moderateComment: (id: number, action: string) => Promise<void>;
    }
  }

  // Admin dashboard functionality
  if (document.querySelector('.tab-button')) {
    interface Comment {
      id: number;
      name: string;
      email?: string;
      relationship?: string;
      message: string;
      imageUrl?: string;
      status: string;
      createdAt: string;
      updatedAt: string;
    }

    interface Counts {
      pending: number;
      approved: number;
      rejected: number;
      total: number;
    }

    let currentTab = 'pending';
    let comments: Comment[] = [];
    let counts: Counts = { pending: 0, approved: 0, rejected: 0, total: 0 };

    // DOM elements
    const tabButtons = document.querySelectorAll('.tab-button');
    const commentsContainer = document.getElementById('commentsContainer');
    const sectionTitle = document.getElementById('sectionTitle');
    const pendingCount = document.getElementById('pendingCount');
    const approvedCount = document.getElementById('approvedCount');
    const rejectedCount = document.getElementById('rejectedCount');
    const totalCount = document.getElementById('totalCount');

    // Load comments
    async function loadComments(status: string = 'pending') {
      try {
        const response = await fetch(`/api/admin/comments?status=${status}`);
        const result = await response.json();

        if (result.success) {
          comments = result.data.comments;
          counts = result.data.counts;
          
          // Update counts
          if (pendingCount) pendingCount.textContent = String(counts.pending);
          if (approvedCount) approvedCount.textContent = String(counts.approved);
          if (rejectedCount) rejectedCount.textContent = String(counts.rejected);
          if (totalCount) totalCount.textContent = String(counts.total);
          
          // Update section title
          const titles: { [key: string]: string } = {
            pending: `Pending Review (${counts.pending})`,
            approved: `Approved Comments (${counts.approved})`,
            rejected: `Rejected Comments (${counts.rejected})`,
            all: `All Comments (${counts.total})`
          };
          if (sectionTitle) sectionTitle.textContent = titles[status] || 'Comments';
          
          // Render comments
          renderComments();
        } else {
          throw new Error(result.error);
        }
      } catch (error) {
        console.error('Error loading comments:', error);
        if (commentsContainer) {
          commentsContainer.innerHTML = `
            <div class="p-6 text-center text-red-600">
              <p>Error loading comments. Please refresh the page.</p>
            </div>
          `;
        }
      }
    }

    // Render comments
    function renderComments() {
      if (!commentsContainer) return;
      
      if (comments.length === 0) {
        commentsContainer.innerHTML = `
          <div class="p-6 text-center text-gray-500">
            <p>No comments found for this filter.</p>
          </div>
        `;
        return;
      }

      const commentsHtml = comments.map(comment => `
        <div class="p-6 comment-item" data-id="${comment.id}">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <h4 class="text-lg font-medium text-gray-900">${escapeHtml(comment.name)}</h4>
                ${comment.relationship ? `<span class="ml-2 px-2 py-1 text-xs bg-gray-100 text-gray-600 rounded">${escapeHtml(comment.relationship)}</span>` : ''}
                <span class="ml-2 px-2 py-1 text-xs rounded ${
                  comment.status === 'approved' ? 'bg-green-100 text-green-800' : 
                  comment.status === 'rejected' ? 'bg-red-100 text-red-800' : 
                  'bg-yellow-100 text-yellow-800'
                }">
                  ${comment.status.charAt(0).toUpperCase() + comment.status.slice(1)}
                </span>
              </div>
              ${comment.email ? `<p class="text-sm text-gray-600 mb-2">Email: ${escapeHtml(comment.email)}</p>` : ''}
              ${comment.imageUrl ? `
                <div class="mb-3">
                  <a href="${escapeHtml(comment.imageUrl)}" target="_blank" rel="noopener noreferrer" class="inline-block">
                    <img src="${escapeHtml(comment.imageUrl)}" alt="Attached photo" class="h-32 w-auto object-cover rounded-lg border border-gray-200 hover:opacity-90 transition-opacity" />
                  </a>
                </div>
              ` : ''}
              <p class="text-gray-700 mb-3">${escapeHtml(comment.message)}</p>
              <p class="text-sm text-gray-500">
                Submitted: ${formatDate(comment.createdAt)}
                ${comment.updatedAt !== comment.createdAt ? ` • Updated: ${formatDate(comment.updatedAt)}` : ''}
              </p>
            </div>
            <div class="ml-4 flex-shrink-0">
              ${comment.status === 'pending' ? `
                <button
                  onclick="moderateComment(${comment.id}, 'approve')"
                  class="mr-2 bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700"
                >
                  Approve
                </button>
                <button
                  onclick="moderateComment(${comment.id}, 'reject')"
                  class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700"
                >
                  Reject
                </button>
              ` : comment.status === 'approved' ? `
                <button
                  onclick="moderateComment(${comment.id}, 'reject')"
                  class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700"
                >
                  Reject
                </button>
              ` : comment.status === 'rejected' ? `
                <button
                  onclick="moderateComment(${comment.id}, 'approve')"
                  class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700"
                >
                  Approve
                </button>
                <span class="text-sm text-gray-500 ml-2">Rejected</span>
              ` : ''}
            </div>
          </div>
        </div>
      `).join('');

      if (commentsContainer) {
        commentsContainer.innerHTML = commentsHtml;
      }
    }

    // Moderate comment
    window.moderateComment = async function(id: number, action: string) {
      // Only confirm for reject action, not for approve
      if (action === 'reject') {
        if (!confirm('Are you sure you want to reject this comment?')) {
          return;
        }
      }

      try {
        const response = await fetch('/api/admin/comments', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ id, action })
        });

        const result = await response.json();

        if (result.success) {
          // Reload comments to reflect changes
          loadComments(currentTab);
          
          // Show success message
          const message = document.createElement('div');
          message.className = 'fixed top-4 right-4 bg-green-500 text-white px-4 py-2 rounded shadow-lg z-50';
          message.textContent = result.message;
          document.body.appendChild(message);
          
          setTimeout(() => {
            document.body.removeChild(message);
          }, 3000);
        } else {
          throw new Error(result.error);
        }
      } catch (error) {
        console.error('Error moderating comment:', error);
        alert('Error processing request. Please try again.');
      }
    };

    // Tab switching
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tab = (button as HTMLElement).dataset.tab;
        
        // Update active tab
        tabButtons.forEach(btn => {
          btn.classList.remove('border-indigo-500', 'text-indigo-600');
          btn.classList.add('border-transparent', 'text-gray-500');
        });
        button.classList.remove('border-transparent', 'text-gray-500');
        button.classList.add('border-indigo-500', 'text-indigo-600');
        
        currentTab = tab || 'pending';
        loadComments(tab || 'pending');
      });
    });

    // Utility functions
    function escapeHtml(text: string) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function formatDate(dateString: string) {
      return new Date(dateString).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    // Initial load
    loadComments('pending');
    
    // Set initial active tab
    const initialTab = document.querySelector('[data-tab="pending"]');
    if (initialTab) {
      (initialTab as HTMLElement).click();
    }
  }
</script>

</body>
</html>