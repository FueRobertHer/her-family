---
// @ts-nocheck
export const prerender = false;
import { db, Memorials } from 'astro:db';

// Check for authentication
const cookies = Astro.cookies;
const authCookie = cookies.get('admin_auth');
const isAuthenticated = authCookie?.value === 'true';
const memorials = isAuthenticated ? await db.select().from(Memorials) : [];
const selectedMemorialSlug =
  Astro.url.searchParams.get('memorial') || 'all';

// Handle logout
if (Astro.url.searchParams.get('logout') === 'true') {
  cookies.delete('admin_auth');
  return Astro.redirect('/admin');
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Memorial Page</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 300 700;
      font-display: block;
      src: url('/fonts/inter-latin-var.woff2') format('woff2');
      unicode-range:
        U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
        U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    @font-face {
      font-family: 'Inter Fallback';
      src: local('Arial');
      size-adjust: 107%;
      ascent-override: 90%;
      descent-override: 22%;
      line-gap-override: 0%;
    }

    body {
      font-family:
        'Inter',
        'Inter Fallback',
        -apple-system,
        BlinkMacSystemFont,
        'Segoe UI',
        system-ui,
        sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-size: 16px;
      line-height: 1.5;
    }
  </style>
</head>
<body class="bg-warm-gray-50 text-warm-gray-900 antialiased">
  <header class="sticky top-0 z-40 border-b border-warm-gray-200/80 bg-white/90 backdrop-blur-sm">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <nav class="flex h-14 items-center justify-between" aria-label="Primary">
        <a href="/" class="text-lg font-semibold text-warm-gray-900 hover:text-warm-gray-700 transition-colors">
          The Her Family
        </a>
        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href="/"
            class="rounded-md px-3 py-1.5 text-sm transition-colors text-warm-gray-700 hover:bg-warm-gray-100"
          >
            Home
          </a>
          <a
            href="/memorials"
            class="rounded-md px-3 py-1.5 text-sm transition-colors text-warm-gray-700 hover:bg-warm-gray-100"
          >
            Memorials
          </a>
          <a
            href="/admin?logout=true"
            class="rounded-md px-3 py-1.5 text-sm transition-colors bg-red-600 text-white hover:bg-red-700"
          >
            Logout
          </a>
        </div>
      </nav>
    </div>
  </header>

{!isAuthenticated ? (
  <div class="min-h-screen flex items-center justify-center">
    {/* Login Form */}
    <div class="max-w-md w-full space-y-8">
      <div>
        <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
          Admin Access
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
          Enter password to manage comments
        </p>
      </div>
      <form id="loginForm" class="mt-8 space-y-6">
        <div>
          <label for="password" class="sr-only">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
            placeholder="Admin password"
          />
        </div>
        <div id="loginError" class="text-red-600 text-sm text-center hidden"></div>
        <div>
          <button
            type="submit"
            id="loginButton"
            class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50"
          >
            Sign in
          </button>
        </div>
      </form>

      <script>
        // Handle login form submission
        const loginForm = document.getElementById('loginForm');
        if (loginForm) {
          loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const passwordInput = document.getElementById('password') as HTMLInputElement | null;
            const loginButton = document.getElementById('loginButton') as HTMLButtonElement | null;
            const loginError = document.getElementById('loginError');
            
            if (!passwordInput || !loginButton || !loginError) return;
            
            const password = passwordInput.value;
            
            // Reset error state
            loginError.classList.add('hidden');
            loginButton.disabled = true;
            loginButton.textContent = 'Signing in...';
            
            try {
              const response = await fetch('/api/admin/login', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({ password })
              });
              
              const result = await response.json();
              
              if (result.success) {
                // Show success message briefly before redirect
                loginError.textContent = 'Login successful! Checking authentication...';
                loginError.classList.remove('hidden');
                loginError.classList.remove('text-red-600');
                loginError.classList.add('text-green-600');
                
                // Redirect after a brief delay
                setTimeout(() => {
                  window.location.reload(); // Use reload instead of href to ensure fresh page load
                }, 1500);
              } else {
                loginError.textContent = result.error || 'Login failed';
                loginError.classList.remove('hidden');
              }
            } catch (error) {
              console.error('Login error:', error);
              loginError.textContent = 'Login failed. Please try again.';
              loginError.classList.remove('hidden');
            } finally {
              loginButton.disabled = false;
              loginButton.textContent = 'Sign in';
            }
          });
        }
      </script>
    </div>
  </div>
) : (
  <div class="min-h-screen bg-gray-50">
    {/* Main Content */}
    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
      <div class="bg-white shadow rounded-lg mb-6">
        <div class="border-b border-gray-200 px-6">
          <nav class="-mb-px flex space-x-8 overflow-x-auto" aria-label="Admin sections">
            <button
              class="admin-section-tab border-indigo-500 text-indigo-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"
              data-section="comments"
            >
              Comments
            </button>
            <button
              class="admin-section-tab border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"
              data-section="memorials"
            >
              Memorials
            </button>
          </nav>
        </div>
      </div>

      <section id="commentsSection">
        <div class="bg-white shadow rounded-lg mb-6">
          <div class="px-6 py-4 flex items-center gap-4">
            <label class="text-sm text-gray-600">
              Memorial:
              <select id="memorialSelect" class="ml-2 border border-gray-300 rounded-md px-2 py-1">
                <option value="all" selected={selectedMemorialSlug === 'all'}>All memorials</option>
                {memorials.map((memorial) => (
                  <option value={memorial.slug} selected={memorial.slug === selectedMemorialSlug}>
                    {memorial.name}
                  </option>
                ))}
              </select>
            </label>
          </div>
        </div>

        {/* Filter Tabs */}
        <div class="bg-white shadow rounded-lg mb-6">
          <div class="border-b border-gray-200">
            <nav class="-mb-px flex space-x-8 px-6 overflow-x-auto" aria-label="Comment status tabs">
              <button
                class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center"
                data-tab="pending"
              >
                Pending Review
                <span id="pendingCount" class="ml-2 bg-yellow-100 text-yellow-800 py-0.5 px-2 rounded-full text-xs">0</span>
              </button>
              <button
                class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center"
                data-tab="approved"
              >
                Approved
                <span id="approvedCount" class="ml-2 bg-green-100 text-green-800 py-0.5 px-2 rounded-full text-xs">0</span>
              </button>
              <button
                class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center"
                data-tab="rejected"
              >
                Rejected
                <span id="rejectedCount" class="ml-2 bg-red-100 text-red-800 py-0.5 px-2 rounded-full text-xs">0</span>
              </button>
              <button
                class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center"
                data-tab="all"
              >
                All Comments
                <span id="totalCount" class="ml-2 bg-gray-100 text-gray-800 py-0.5 px-2 rounded-full text-xs">0</span>
              </button>
            </nav>
          </div>
        </div>

        {/* Comments List */}
        <div class="bg-white shadow rounded-lg">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg leading-6 font-medium text-gray-900" id="sectionTitle">
              Loading comments...
            </h3>
          </div>
          <div id="commentsContainer" class="divide-y divide-gray-200">
            {/* Comments will be loaded here */}
            <div class="p-6 text-center">
              <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600 mx-auto"></div>
              <p class="text-gray-600 mt-2">Loading comments...</p>
            </div>
          </div>
        </div>
      </section>

      <section id="memorialsSection" class="hidden">
        <div class="bg-white shadow rounded-lg">
          <div class="px-6 py-4 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
              <h3 class="text-lg font-medium text-gray-900">Manage Memorials</h3>
              <p class="text-sm text-gray-600 mt-1">Set visibility, edit slug, or remove a memorial.</p>
            </div>
            <button id="openCreateMemorialModalBtn" class="px-4 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-700 text-sm">
              Add Memorial
            </button>
          </div>
          <div id="memorialsContainer" class="divide-y divide-gray-200">
            <div class="p-6 text-center text-gray-500">Loading memorials...</div>
          </div>
        </div>

        <div id="createMemorialModal" class="hidden fixed inset-0 z-50 bg-black/50 p-4 pt-20">
          <div class="w-full max-w-md mx-auto rounded-lg bg-white shadow-xl">
            <div class="border-b border-gray-200 px-6 py-4 flex items-center justify-between">
              <h3 class="text-lg font-semibold text-gray-900">Create Memorial</h3>
              <button id="closeCreateMemorialModalBtn" class="text-gray-500 hover:text-gray-700 text-2xl leading-none" aria-label="Close">&times;</button>
            </div>
            <form id="createMemorialForm" class="px-6 py-4 space-y-4">
              <div>
                <label for="memorialName" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                <input id="memorialName" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-md" placeholder="e.g. John Doe Memorial" />
              </div>
              <div>
                <label for="memorialSlug" class="block text-sm font-medium text-gray-700 mb-1">Slug (optional)</label>
                <input id="memorialSlug" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md" placeholder="john-doe-memorial" />
              </div>
              <p id="memorialCreateMessage" class="hidden text-sm"></p>
              <div class="flex justify-end gap-3 border-t border-gray-200 bg-gray-50 -mx-6 -mb-4 mt-5 px-6 py-4 rounded-b-lg">
                <button type="button" id="cancelCreateMemorialBtn" class="px-4 py-2 rounded-md border border-gray-300 text-gray-700 hover:bg-gray-100">
                  Cancel
                </button>
                <button type="submit" id="createMemorialBtn" class="px-4 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-700">
                  Create Memorial
                </button>
              </div>
            </form>
          </div>
        </div>

        <div id="deleteMemorialModal" class="hidden fixed inset-0 z-50 bg-black/50 p-4 pt-20">
          <div class="w-full max-w-md mx-auto rounded-lg bg-white shadow-xl">
            <div class="border-b border-gray-200 px-6 py-4">
              <h3 class="text-lg font-semibold text-gray-900">Delete Memorial</h3>
            </div>
            <div class="px-6 py-4 space-y-3">
              <p class="text-sm text-gray-700">
                This action permanently deletes the memorial and all related content, comments, and gallery items.
              </p>
              <p class="text-sm text-gray-700">
                Type <span id="deleteMemorialExpectedName" class="font-semibold"></span> to confirm.
              </p>
              <input
                id="deleteMemorialConfirmInput"
                type="text"
                class="w-full px-3 py-2 border border-gray-300 rounded-md"
                placeholder="Type memorial name exactly"
              />
              <p id="deleteMemorialMessage" class="hidden text-sm text-red-600"></p>
            </div>
            <div class="flex justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4">
              <button id="cancelDeleteMemorialBtn" class="px-4 py-2 rounded-md border border-gray-300 text-gray-700 hover:bg-gray-100">
                Cancel
              </button>
              <button id="confirmDeleteMemorialBtn" class="px-4 py-2 rounded-md bg-red-600 text-white hover:bg-red-700">
                Delete Memorial
              </button>
            </div>
          </div>
        </div>

        <div id="editMemorialModal" class="hidden fixed inset-0 z-50 bg-black/50 p-4 pt-20">
          <div class="w-full max-w-md mx-auto rounded-lg bg-white shadow-xl">
            <div class="border-b border-gray-200 px-6 py-4">
              <h3 class="text-lg font-semibold text-gray-900">Edit Memorial</h3>
            </div>
            <div class="px-6 py-4 space-y-3">
              <label for="editMemorialNameInput" class="block text-sm font-medium text-gray-700">Name</label>
              <input
                id="editMemorialNameInput"
                type="text"
                class="w-full px-3 py-2 border border-gray-300 rounded-md"
                placeholder="Memorial name"
              />
              <label for="editMemorialSlugInput" class="block text-sm font-medium text-gray-700">Slug</label>
              <input
                id="editMemorialSlugInput"
                type="text"
                class="w-full px-3 py-2 border border-gray-300 rounded-md"
                placeholder="memorial-slug"
              />
              <p id="editMemorialMessage" class="hidden text-sm text-red-600"></p>
            </div>
            <div class="flex justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4">
              <button id="cancelEditMemorialBtn" class="px-4 py-2 rounded-md border border-gray-300 text-gray-700 hover:bg-gray-100">
                Cancel
              </button>
              <button id="saveEditMemorialBtn" class="px-4 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-700">
                Save Changes
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
)}

<script>
  // Global type declarations
  declare global {
    interface Window {
      moderateComment: (id: number, action: string) => Promise<void>;
      toggleMemorialVisibility: (id: number, nextStatus: 'active' | 'hidden') => Promise<void>;
      requestMemorialDelete: (id: number) => void;
      requestMemorialEdit: (id: number) => void;
    }
  }

  // Admin dashboard functionality
  if (document.querySelector('.tab-button')) {
    interface Comment {
      id: number;
      memorialId: number;
      memorialName?: string;
      memorialSlug?: string;
      name: string;
      email?: string;
      relationship?: string;
      message: string;
      imageUrl?: string;
      status: string;
      createdAt: string;
      updatedAt: string;
    }

    interface Counts {
      pending: number;
      approved: number;
      rejected: number;
      total: number;
    }

    interface Memorial {
      id: number;
      slug: string;
      name: string;
      status: 'active' | 'hidden' | string;
      createdAt: string;
      updatedAt: string;
    }

    let currentTab = 'pending';
    let currentSection: 'comments' | 'memorials' = 'comments';
    let comments: Comment[] = [];
    let memorialList: Memorial[] = [];
    let pendingDeleteMemorial: Memorial | null = null;
    let pendingEditMemorial: Memorial | null = null;
    let counts: Counts = { pending: 0, approved: 0, rejected: 0, total: 0 };

    // DOM elements
    const sectionTabs = document.querySelectorAll('.admin-section-tab');
    const commentsSection = document.getElementById('commentsSection');
    const memorialsSection = document.getElementById('memorialsSection');
    const tabButtons = document.querySelectorAll('.tab-button');
    const commentsContainer = document.getElementById('commentsContainer');
    const sectionTitle = document.getElementById('sectionTitle');
    const pendingCount = document.getElementById('pendingCount');
    const approvedCount = document.getElementById('approvedCount');
    const rejectedCount = document.getElementById('rejectedCount');
    const totalCount = document.getElementById('totalCount');
    const memorialSelect = document.getElementById('memorialSelect') as HTMLSelectElement | null;
    const memorialsContainer = document.getElementById('memorialsContainer');
    const createMemorialModal = document.getElementById('createMemorialModal');
    const openCreateMemorialModalBtn = document.getElementById('openCreateMemorialModalBtn');
    const closeCreateMemorialModalBtn = document.getElementById('closeCreateMemorialModalBtn');
    const cancelCreateMemorialBtn = document.getElementById('cancelCreateMemorialBtn');
    const createMemorialForm = document.getElementById('createMemorialForm') as HTMLFormElement | null;
    const memorialNameInput = document.getElementById('memorialName') as HTMLInputElement | null;
    const memorialSlugInput = document.getElementById('memorialSlug') as HTMLInputElement | null;
    const memorialCreateMessage = document.getElementById('memorialCreateMessage');
    const createMemorialBtn = document.getElementById('createMemorialBtn') as HTMLButtonElement | null;
    const deleteMemorialModal = document.getElementById('deleteMemorialModal');
    const deleteMemorialExpectedName = document.getElementById('deleteMemorialExpectedName');
    const deleteMemorialConfirmInput = document.getElementById('deleteMemorialConfirmInput') as HTMLInputElement | null;
    const deleteMemorialMessage = document.getElementById('deleteMemorialMessage');
    const cancelDeleteMemorialBtn = document.getElementById('cancelDeleteMemorialBtn');
    const confirmDeleteMemorialBtn = document.getElementById('confirmDeleteMemorialBtn') as HTMLButtonElement | null;
    const editMemorialModal = document.getElementById('editMemorialModal');
    const editMemorialNameInput = document.getElementById('editMemorialNameInput') as HTMLInputElement | null;
    const editMemorialSlugInput = document.getElementById('editMemorialSlugInput') as HTMLInputElement | null;
    const editMemorialMessage = document.getElementById('editMemorialMessage');
    const cancelEditMemorialBtn = document.getElementById('cancelEditMemorialBtn');
    const saveEditMemorialBtn = document.getElementById('saveEditMemorialBtn') as HTMLButtonElement | null;
    let currentMemorialSlug = memorialSelect?.value || 'all';

    // Load comments
    async function loadComments(status: string = 'pending') {
      try {
        const response = await fetch(
          `/api/admin/comments?status=${status}&memorial=${encodeURIComponent(currentMemorialSlug)}`
        );
        const result = await response.json();

        if (result.success) {
          comments = result.data.comments;
          counts = result.data.counts;
          
          // Update counts
          if (pendingCount) pendingCount.textContent = String(counts.pending);
          if (approvedCount) approvedCount.textContent = String(counts.approved);
          if (rejectedCount) rejectedCount.textContent = String(counts.rejected);
          if (totalCount) totalCount.textContent = String(counts.total);
          
          // Update section title
          const titles: { [key: string]: string } = {
            pending: `Pending Review (${counts.pending})`,
            approved: `Approved Comments (${counts.approved})`,
            rejected: `Rejected Comments (${counts.rejected})`,
            all: `All Comments (${counts.total})`
          };
          if (sectionTitle) sectionTitle.textContent = titles[status] || 'Comments';
          
          // Render comments
          renderComments();
        } else {
          throw new Error(result.error);
        }
      } catch (error) {
        console.error('Error loading comments:', error);
        if (commentsContainer) {
          commentsContainer.innerHTML = `
            <div class="p-6 text-center text-red-600">
              <p>Error loading comments. Please refresh the page.</p>
            </div>
          `;
        }
      }
    }

    // Render comments
    function renderComments() {
      if (!commentsContainer) return;
      
      if (comments.length === 0) {
        commentsContainer.innerHTML = `
          <div class="p-6 text-center text-gray-500">
            <p>No comments found for this filter.</p>
          </div>
        `;
        return;
      }

      const commentsHtml = comments.map(comment => `
        <div class="p-6 comment-item" data-id="${comment.id}">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <h4 class="text-lg font-medium text-gray-900">${escapeHtml(comment.name)}</h4>
                ${
                  comment.memorialName
                    ? `<span class="ml-2 px-2 py-1 text-xs bg-indigo-50 text-indigo-700 rounded">${escapeHtml(comment.memorialName)}</span>`
                    : ''
                }
                ${comment.relationship ? `<span class="ml-2 px-2 py-1 text-xs bg-gray-100 text-gray-600 rounded">${escapeHtml(comment.relationship)}</span>` : ''}
                <span class="ml-2 px-2 py-1 text-xs rounded ${
                  comment.status === 'approved' ? 'bg-green-100 text-green-800' : 
                  comment.status === 'rejected' ? 'bg-red-100 text-red-800' : 
                  'bg-yellow-100 text-yellow-800'
                }">
                  ${comment.status.charAt(0).toUpperCase() + comment.status.slice(1)}
                </span>
              </div>
              ${comment.email ? `<p class="text-sm text-gray-600 mb-2">Email: ${escapeHtml(comment.email)}</p>` : ''}
              ${comment.imageUrl ? `
                <div class="mb-3">
                  <a href="${escapeHtml(comment.imageUrl)}" target="_blank" rel="noopener noreferrer" class="inline-block">
                    <img src="${escapeHtml(comment.imageUrl)}" alt="Attached photo" class="h-32 w-auto object-cover rounded-lg border border-gray-200 hover:opacity-90 transition-opacity" />
                  </a>
                </div>
              ` : ''}
              <p class="text-gray-700 mb-3">${escapeHtml(comment.message)}</p>
              <p class="text-sm text-gray-500">
                Submitted: ${formatDate(comment.createdAt)}
                ${comment.updatedAt !== comment.createdAt ? ` • Updated: ${formatDate(comment.updatedAt)}` : ''}
              </p>
            </div>
            <div class="ml-4 flex-shrink-0">
              ${comment.status === 'pending' ? `
                <button
                  onclick="moderateComment(${comment.id}, 'approve')"
                  class="mr-2 bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700"
                >
                  Approve
                </button>
                <button
                  onclick="moderateComment(${comment.id}, 'reject')"
                  class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700"
                >
                  Reject
                </button>
              ` : comment.status === 'approved' ? `
                <button
                  onclick="moderateComment(${comment.id}, 'reject')"
                  class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700"
                >
                  Reject
                </button>
              ` : comment.status === 'rejected' ? `
                <button
                  onclick="moderateComment(${comment.id}, 'approve')"
                  class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700"
                >
                  Approve
                </button>
                <span class="text-sm text-gray-500 ml-2">Rejected</span>
              ` : ''}
            </div>
          </div>
        </div>
      `).join('');

      if (commentsContainer) {
        commentsContainer.innerHTML = commentsHtml;
      }
    }

    async function loadMemorials() {
      if (!memorialsContainer) return;
      memorialsContainer.innerHTML = '<div class="p-6 text-center text-gray-500">Loading memorials...</div>';

      try {
        const response = await fetch('/api/admin/memorials');
        const result = await response.json();
        if (!result.success) {
          throw new Error(result.error || 'Failed to load memorials');
        }

        memorialList = result.data || [];
        renderMemorials();
        syncMemorialSelector();
      } catch (error) {
        console.error('Error loading memorials:', error);
        memorialsContainer.innerHTML = `
          <div class="p-6 text-center text-red-600">
            <p>Error loading memorials. Please refresh the page.</p>
          </div>
        `;
      }
    }

    function renderMemorials() {
      if (!memorialsContainer) return;

      if (memorialList.length === 0) {
        memorialsContainer.innerHTML = `
          <div class="p-6 text-center text-gray-500">
            <p>No memorials found yet.</p>
          </div>
        `;
        return;
      }

      memorialsContainer.innerHTML = memorialList
        .map(
          (memorial) => `
          <div class="p-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="flex items-center gap-2">
                <h4 class="text-base font-medium text-gray-900">${escapeHtml(memorial.name)}</h4>
                <span class="px-2 py-0.5 text-xs rounded ${
                  memorial.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-200 text-gray-700'
                }">
                  ${memorial.status === 'active' ? 'Public' : 'Hidden'}
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-1">/${escapeHtml(memorial.slug)}</p>
            </div>
            <div class="flex items-center gap-2">
              <a
                href="/memorials/${encodeURIComponent(memorial.slug)}"
                class="px-3 py-1.5 rounded-md text-sm border border-gray-300 text-gray-700 hover:bg-gray-50"
              >
                Edit Content
              </a>
              <button
                onclick="toggleMemorialVisibility(${memorial.id}, '${memorial.status === 'active' ? 'hidden' : 'active'}')"
                class="px-3 py-1.5 rounded-md text-sm ${
                  memorial.status === 'active'
                    ? 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                    : 'bg-green-600 text-white hover:bg-green-700'
                }"
              >
                ${memorial.status === 'active' ? 'Hide' : 'Show Publicly'}
              </button>
              <button
                onclick="requestMemorialEdit(${memorial.id})"
                class="px-3 py-1.5 rounded-md text-sm bg-indigo-600 text-white hover:bg-indigo-700"
              >
                Edit
              </button>
              <button
                onclick="requestMemorialDelete(${memorial.id})"
                class="px-3 py-1.5 rounded-md text-sm bg-red-600 text-white hover:bg-red-700"
              >
                Delete
              </button>
            </div>
          </div>
        `
        )
        .join('');
    }

    window.toggleMemorialVisibility = async function(id: number, nextStatus: 'active' | 'hidden') {
      try {
        const response = await fetch('/api/admin/memorials', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ id, status: nextStatus }),
        });
        const result = await response.json();
        if (!result.success) {
          throw new Error(result.error || 'Failed to update memorial visibility');
        }

        showToast(result.message || 'Memorial updated');
        await loadMemorials();
      } catch (error) {
        console.error('Error updating memorial visibility:', error);
        alert('Error updating memorial visibility. Please try again.');
      }
    };

    function showDeleteError(message: string) {
      if (!deleteMemorialMessage) return;
      if (!message) {
        deleteMemorialMessage.classList.add('hidden');
        deleteMemorialMessage.textContent = '';
        return;
      }
      deleteMemorialMessage.classList.remove('hidden');
      deleteMemorialMessage.textContent = message;
    }

    function closeDeleteModal() {
      pendingDeleteMemorial = null;
      showDeleteError('');
      if (deleteMemorialConfirmInput) deleteMemorialConfirmInput.value = '';
      deleteMemorialModal?.classList.add('hidden');
      confirmDeleteMemorialBtn?.removeAttribute('disabled');
      if (confirmDeleteMemorialBtn) confirmDeleteMemorialBtn.textContent = 'Delete Memorial';
    }

    window.requestMemorialDelete = function(id: number) {
      const memorial = memorialList.find((item) => item.id === id);
      if (!memorial) {
        alert('Memorial not found');
        return;
      }
      pendingDeleteMemorial = memorial;
      if (deleteMemorialExpectedName) {
        deleteMemorialExpectedName.textContent = memorial.name;
      }
      if (deleteMemorialConfirmInput) {
        deleteMemorialConfirmInput.value = '';
      }
      showDeleteError('');
      deleteMemorialModal?.classList.remove('hidden');
      deleteMemorialConfirmInput?.focus();
    };

    function showEditMemorialError(message: string) {
      if (!editMemorialMessage) return;
      if (!message) {
        editMemorialMessage.classList.add('hidden');
        editMemorialMessage.textContent = '';
        return;
      }
      editMemorialMessage.classList.remove('hidden');
      editMemorialMessage.textContent = message;
    }

    function closeEditMemorialModal() {
      pendingEditMemorial = null;
      showEditMemorialError('');
      if (editMemorialNameInput) editMemorialNameInput.value = '';
      if (editMemorialSlugInput) editMemorialSlugInput.value = '';
      editMemorialModal?.classList.add('hidden');
      saveEditMemorialBtn?.removeAttribute('disabled');
      if (saveEditMemorialBtn) saveEditMemorialBtn.textContent = 'Save Changes';
    }

    window.requestMemorialEdit = function(id: number) {
      const memorial = memorialList.find((item) => item.id === id);
      if (!memorial) {
        alert('Memorial not found');
        return;
      }
      pendingEditMemorial = memorial;
      if (editMemorialNameInput) {
        editMemorialNameInput.value = memorial.name;
      }
      if (editMemorialSlugInput) {
        editMemorialSlugInput.value = memorial.slug;
      }
      showEditMemorialError('');
      editMemorialModal?.classList.remove('hidden');
      editMemorialNameInput?.focus();
      editMemorialNameInput?.select();
    };

    function syncMemorialSelector() {
      if (!memorialSelect) return;

      const memorialOptions = memorialList.map((memorial) => {
          const selected = memorial.slug === currentMemorialSlug ? 'selected' : '';
          return `<option value="${escapeHtml(memorial.slug)}" ${selected}>${escapeHtml(memorial.name)}</option>`;
        });
      const allOptionSelected = currentMemorialSlug === 'all' ? 'selected' : '';
      const options = [`<option value="all" ${allOptionSelected}>All memorials</option>`, ...memorialOptions].join('');

      memorialSelect.innerHTML = options;

      if (
        currentMemorialSlug !== 'all' &&
        !memorialList.some((memorial) => memorial.slug === currentMemorialSlug) &&
        memorialList.length > 0
      ) {
        currentMemorialSlug = memorialList[0].slug;
        memorialSelect.value = currentMemorialSlug;
      }
    }

    // Moderate comment
    window.moderateComment = async function(id: number, action: string) {
      // Only confirm for reject action, not for approve
      if (action === 'reject') {
        if (!confirm('Are you sure you want to reject this comment?')) {
          return;
        }
      }

      try {
        const response = await fetch('/api/admin/comments', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ id, action, memorialSlug: currentMemorialSlug })
        });

        const result = await response.json();

        if (result.success) {
          // Reload comments to reflect changes
          loadComments(currentTab);

          showToast(result.message || 'Comment updated');
        } else {
          throw new Error(result.error);
        }
      } catch (error) {
        console.error('Error moderating comment:', error);
        alert('Error processing request. Please try again.');
      }
    };

    // Comment status tab switching
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tab = (button as HTMLElement).dataset.tab;
        
        // Update active tab
        tabButtons.forEach(btn => {
          btn.classList.remove('border-indigo-500', 'text-indigo-600');
          btn.classList.add('border-transparent', 'text-gray-500');
        });
        button.classList.remove('border-transparent', 'text-gray-500');
        button.classList.add('border-indigo-500', 'text-indigo-600');
        
        currentTab = tab || 'pending';
        loadComments(tab || 'pending');
      });
    });

    // Admin section switching
    sectionTabs.forEach((button) => {
      button.addEventListener('click', () => {
        const nextSection = ((button as HTMLElement).dataset.section || 'comments') as 'comments' | 'memorials';
        currentSection = nextSection;

        sectionTabs.forEach((tab) => {
          tab.classList.remove('border-indigo-500', 'text-indigo-600');
          tab.classList.add('border-transparent', 'text-gray-500');
        });
        button.classList.remove('border-transparent', 'text-gray-500');
        button.classList.add('border-indigo-500', 'text-indigo-600');

        if (currentSection === 'comments') {
          commentsSection?.classList.remove('hidden');
          memorialsSection?.classList.add('hidden');
          loadComments(currentTab);
        } else {
          commentsSection?.classList.add('hidden');
          memorialsSection?.classList.remove('hidden');
          loadMemorials();
        }
      });
    });

    // Utility functions
    function escapeHtml(text: string) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function formatDate(dateString: string) {
      return new Date(dateString).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    function showToast(message: string) {
      const toast = document.createElement('div');
      toast.className = 'fixed top-4 right-4 bg-green-500 text-white px-4 py-2 rounded shadow-lg z-50';
      toast.textContent = message;
      document.body.appendChild(toast);

      setTimeout(() => {
        if (toast.parentNode) {
          toast.parentNode.removeChild(toast);
        }
      }, 3000);
    }

    function setCreateMessage(text: string, isError: boolean) {
      if (!memorialCreateMessage) return;
      memorialCreateMessage.classList.remove('hidden', 'text-red-600', 'text-green-600');
      memorialCreateMessage.classList.add(isError ? 'text-red-600' : 'text-green-600');
      memorialCreateMessage.textContent = text;
    }

    function openCreateMemorialModal() {
      createMemorialModal?.classList.remove('hidden');
      setCreateMessage('', false);
      memorialCreateMessage?.classList.add('hidden');
      memorialNameInput?.focus();
    }

    function closeCreateMemorialModal() {
      createMemorialModal?.classList.add('hidden');
      setCreateMessage('', false);
      memorialCreateMessage?.classList.add('hidden');
      if (memorialNameInput) memorialNameInput.value = '';
      if (memorialSlugInput) memorialSlugInput.value = '';
      if (createMemorialBtn) {
        createMemorialBtn.disabled = false;
        createMemorialBtn.textContent = 'Create Memorial';
      }
    }

    createMemorialForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!memorialNameInput || !createMemorialBtn) return;

      const name = memorialNameInput.value.trim();
      const slug = memorialSlugInput?.value.trim() || '';
      if (!name) {
        setCreateMessage('Name is required', true);
        return;
      }

      createMemorialBtn.disabled = true;
      createMemorialBtn.textContent = 'Creating...';
      setCreateMessage('', false);
      memorialCreateMessage?.classList.add('hidden');

      try {
        const response = await fetch('/api/admin/memorials', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ name, slug }),
        });
        const result = await response.json();
        if (!result.success) {
          throw new Error(result.error || 'Failed to create memorial');
        }

        memorialNameInput.value = '';
        if (memorialSlugInput) memorialSlugInput.value = '';
        setCreateMessage(result.message || 'Memorial created successfully', false);
        showToast(result.message || 'Memorial created successfully');
        await loadMemorials();
        closeCreateMemorialModal();
      } catch (error) {
        console.error('Error creating memorial:', error);
        setCreateMessage(error instanceof Error ? error.message : 'Failed to create memorial', true);
      } finally {
        createMemorialBtn.disabled = false;
        createMemorialBtn.textContent = 'Create Memorial';
      }
    });

    openCreateMemorialModalBtn?.addEventListener('click', openCreateMemorialModal);
    closeCreateMemorialModalBtn?.addEventListener('click', closeCreateMemorialModal);
    cancelCreateMemorialBtn?.addEventListener('click', closeCreateMemorialModal);

    cancelDeleteMemorialBtn?.addEventListener('click', closeDeleteModal);
    cancelEditMemorialBtn?.addEventListener('click', closeEditMemorialModal);

    confirmDeleteMemorialBtn?.addEventListener('click', async () => {
      if (!pendingDeleteMemorial) {
        closeDeleteModal();
        return;
      }
      if (!deleteMemorialConfirmInput) return;

      const confirmationName = deleteMemorialConfirmInput.value.trim();
      if (confirmationName !== pendingDeleteMemorial.name) {
        showDeleteError('Name does not match. Please type it exactly.');
        return;
      }

      confirmDeleteMemorialBtn.disabled = true;
      confirmDeleteMemorialBtn.textContent = 'Deleting...';
      showDeleteError('');

      try {
        const response = await fetch('/api/admin/memorials', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: pendingDeleteMemorial.id,
            confirmationName,
          }),
        });
        const result = await response.json();
        if (!result.success) {
          throw new Error(result.error || 'Failed to delete memorial');
        }

        const deletedSlug = pendingDeleteMemorial.slug;
        closeDeleteModal();
        showToast(result.message || 'Memorial deleted successfully');
        await loadMemorials();
        if (currentMemorialSlug === deletedSlug) {
          loadComments(currentTab);
        }
      } catch (error) {
        console.error('Error deleting memorial:', error);
        showDeleteError(error instanceof Error ? error.message : 'Failed to delete memorial');
        confirmDeleteMemorialBtn.disabled = false;
        confirmDeleteMemorialBtn.textContent = 'Delete Memorial';
      }
    });

    saveEditMemorialBtn?.addEventListener('click', async () => {
      if (!pendingEditMemorial || !editMemorialNameInput || !editMemorialSlugInput || !saveEditMemorialBtn) {
        closeEditMemorialModal();
        return;
      }

      const nextName = editMemorialNameInput.value.trim();
      const nextSlug = editMemorialSlugInput.value.trim();

      if (!nextName) {
        showEditMemorialError('Name is required');
        return;
      }

      if (!nextSlug) {
        showEditMemorialError('Slug is required');
        return;
      }

      if (nextName === pendingEditMemorial.name && nextSlug === pendingEditMemorial.slug) {
        closeEditMemorialModal();
        return;
      }

      saveEditMemorialBtn.disabled = true;
      saveEditMemorialBtn.textContent = 'Saving...';
      showEditMemorialError('');

      try {
        const response = await fetch('/api/admin/memorials', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: pendingEditMemorial.id,
            name: nextName,
            slug: nextSlug,
          }),
        });
        const result = await response.json();
        if (!result.success) {
          throw new Error(result.error || 'Failed to update memorial');
        }

        const previousSlug = pendingEditMemorial.slug;
        const updatedSlug = result.data?.slug || nextSlug;
        if (currentMemorialSlug === previousSlug) {
          currentMemorialSlug = updatedSlug;
        }

        closeEditMemorialModal();
        showToast(result.message || 'Memorial updated');
        await loadMemorials();
        loadComments(currentTab);
      } catch (error) {
        console.error('Error updating memorial:', error);
        showEditMemorialError(error instanceof Error ? error.message : 'Failed to update memorial');
        saveEditMemorialBtn.disabled = false;
        saveEditMemorialBtn.textContent = 'Save Changes';
      }
    });

    // Initial load
    loadMemorials();

    memorialSelect?.addEventListener('change', () => {
      const nextSlug = memorialSelect.value;
      currentMemorialSlug = nextSlug;
      loadComments(currentTab);
    });
    
    // Set initial active comment tab
    const initialTab = document.querySelector('[data-tab="pending"]');
    if (initialTab) {
      (initialTab as HTMLElement).click();
    }
  }
</script>

</body>
</html>