---
/**
 * The single pencil used by every admin affordance.
 *
 * Previously the toolbar drew a ✏️ emoji while the edit buttons drew this SVG,
 * so the two never matched: the emoji renders in the system colour font, at the
 * text's size, and is styled by the OS rather than by us.
 */
export interface Props {
  /** Size utilities. Defaults to the 16px used by the edit buttons. */
  class?: string;
}

const { class: className = 'w-4 h-4' } = Astro.props;
---

<svg
  class={`${className} shrink-0`}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  <path
    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
  ></path>
</svg>
