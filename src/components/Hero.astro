---
import { optimizeCloudinaryUrl, CloudinaryPresets } from '../lib/image-optimization';

export interface Props {
  name: string;
  birthDate: string;
  deathDate: string;
  mainImage: string;
  backgroundImage?: string;
  subtitle?: string;
}

const { name, birthDate, deathDate, mainImage, backgroundImage, subtitle } = Astro.props;

// Use backgroundImage if provided, otherwise fallback to mainImage
const bgImage = backgroundImage || mainImage;

// Optimize images for Cloudinary
const optimizedBgImage = optimizeCloudinaryUrl(bgImage, CloudinaryPresets.heroBackground);
const optimizedMainImage = optimizeCloudinaryUrl(mainImage, CloudinaryPresets.hero);
---

<section class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-100 to-purple-100">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src={optimizedBgImage} 
      alt="Background"
      class="w-full h-full object-cover opacity-90 mix-blend-overlay"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      data-hero-background
    />
    <div class="absolute inset-0 bg-gradient-to-t from-warm-gray-900/10 to-transparent"></div>
  </div>
  
  <!-- Content -->
  <div class="relative z-10 text-center px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <!-- Portrait -->
    <div class="mb-10">
      <div class="w-56 h-56 sm:w-72 sm:h-72 mx-auto rounded-full overflow-hidden border-4 border-white shadow-2xl">
        <img 
          src={optimizedMainImage} 
          alt={`Portrait of ${name}`}
          class="w-full h-full object-cover"
          width="1200"
          height="1200"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-hero-image
        />
      </div>
    </div>
    
    <!-- Name and Dates -->
    <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-warm-gray-900 mb-5 drop-shadow-[0_0_15px_rgba(255,255,255,0.8)]" data-hero-name>
      {name}
    </h1>
    
    <div class="flex items-center justify-center space-x-4 text-xl sm:text-2xl text-warm-gray-50 font-semibold mb-6 drop-shadow-[0_2px_10px_rgba(0,0,0,0.95)]" data-hero-dates>
      <time datetime={birthDate}>{new Date(birthDate).getFullYear()}</time>
      <span class="w-8 h-1 bg-warm-gray-50 rounded-full shadow-sm"></span>
      <time datetime={deathDate}>{new Date(deathDate).getFullYear()}</time>
    </div>
    
    {subtitle && (
      <p class="text-2xl sm:text-3xl text-warm-gray-50 italic max-w-2xl mx-auto mb-8 drop-shadow-[0_4px_10px_rgba(0,0,0,0.95)]" data-hero-subtitle>
        {subtitle}
      </p>
    )}
  </div>
  
  <!-- Scroll Indicator - positioned relative to the entire hero section -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20">
    <button 
      onclick="
        const sections = ['#biography', '#funeral-info', '#gallery', '#video', '#memories', '#donations', 'footer'];
        let target = null;
        for (const selector of sections) {
          const el = document.querySelector(selector);
          if (el && el.offsetParent !== null) { // check if visible
            target = el;
            break;
          }
        }
        if(target) { 
          target.scrollIntoView({ behavior: 'smooth' }); 
        } else { 
          window.scrollBy({ top: window.innerHeight, behavior: 'smooth' }); 
        }
      "
      class="animate-bounce p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors duration-300 backdrop-blur-sm"
      aria-label="Scroll to content"
    >
      <svg class="w-6 h-6 text-warm-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </button>
  </div>
</section>