---
import { optimizeCloudinaryUrl, CloudinaryPresets } from '../lib/image-optimization';

export interface Props {
  name: string;
  birthDate: string;
  deathDate: string;
  mainImage: string;
  backgroundImage?: string;
  subtitle?: string;
}

const { name, birthDate, deathDate, mainImage, backgroundImage, subtitle } = Astro.props;

// Use backgroundImage if provided, otherwise fallback to mainImage
const bgImage = backgroundImage || mainImage;

// Optimize images for Cloudinary
const optimizedBgImage = optimizeCloudinaryUrl(bgImage, CloudinaryPresets.heroBackground);
const optimizedMainImage = optimizeCloudinaryUrl(mainImage, CloudinaryPresets.hero);

// Hero text is light-on-photo and dark-on-gradient. Without this, pale text
// sat on the pale fallback gradient at roughly 1.2:1 contrast, legible only
// because of a heavy drop-shadow. If the background image 404s at runtime the
// class is removed again by the data-fallback="hero-bg" handler.
const hasBackgroundPhoto = Boolean(bgImage);
---

<section
  data-hero
  class:list={[
    'hero relative min-h-screen flex items-center justify-center bg-linear-to-br from-indigo-100 to-purple-100',
    hasBackgroundPhoto && 'hero-has-photo',
  ]}
>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0" data-hero-bg-layer>
    <img
      src={optimizedBgImage}
      alt=""
      class="w-full h-full object-cover opacity-90 mix-blend-overlay"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      data-hero-background
      data-fallback="hero-bg"
    />
    <!-- Scrim: keeps light text readable over an arbitrary photo. -->
    <div
      class="absolute inset-0 bg-linear-to-t from-warm-gray-900/70 via-warm-gray-900/40 to-warm-gray-900/25"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <!-- Portrait -->
    <div class="mb-10">
      <div
        class="w-56 h-56 sm:w-72 sm:h-72 mx-auto rounded-full overflow-hidden border-4 border-white shadow-2xl"
      >
        <img
          src={optimizedMainImage}
          alt={`Portrait of ${name}`}
          class="w-full h-full object-cover"
          width="1200"
          height="1200"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-hero-image
          data-fallback="portrait"
        />
      </div>
    </div>

    <!-- Name and Dates -->
    <h1
      class="hero-text font-display text-5xl sm:text-6xl lg:text-7xl font-bold mb-5"
      data-hero-name
    >
      {name}
    </h1>

    <div
      class="hero-text flex items-center justify-center space-x-4 text-xl sm:text-2xl font-semibold mb-6"
      data-hero-dates
    >
      <time datetime={birthDate}>{new Date(birthDate).getFullYear()}</time>
      <span class="hero-rule w-8 h-1 rounded-full"></span>
      <time datetime={deathDate}>{new Date(deathDate).getFullYear()}</time>
    </div>

    {
      subtitle && (
        <p class="hero-text text-2xl sm:text-3xl italic max-w-2xl mx-auto mb-8" data-hero-subtitle>
          {subtitle}
        </p>
      )
    }
  </div>

  <!-- Scroll Indicator - positioned relative to the entire hero section -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20">
    <button
      data-hero-scroll-cue
      class="hero-text animate-bounce p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors duration-300 backdrop-blur-xs"
      aria-label="Scroll to content"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </button>
  </div>
</section>

<style>
  /*
    Two legible states rather than one pale-on-pale state:
      .hero-has-photo -> light text over the scrim
      no photo        -> dark text on the pastel gradient (~12:1)
    The shadows are a legibility aid on top of the scrim, never the only thing
    separating text from its background.
  */
  .hero-text {
    color: var(--color-warm-gray-800);
  }

  .hero-rule {
    background-color: var(--color-warm-gray-500);
  }

  .hero-has-photo .hero-text {
    color: var(--color-warm-gray-50);
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.75);
  }

  .hero-has-photo .hero-rule {
    background-color: var(--color-warm-gray-50);
  }

  /* Background layer is removed entirely when there is no usable photo, so the
     scrim can't darken the pastel gradient behind dark text. */
  .hero:not(.hero-has-photo) [data-hero-bg-layer] {
    display: none;
  }
</style>

<script>
  import '../scripts/hero.ts';
</script>
