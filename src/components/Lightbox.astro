---
// Reusable lightbox component for displaying images
interface Props {
  id?: string; // Unique ID for this lightbox instance (default: 'lightbox')
}

const { id = 'lightbox' } = Astro.props;
const containerId = `${id}-container`;
const contentId = `${id}-content`;
const imageId = `${id}-image`;
const titleId = `${id}-title`;
---

<div
  id={containerId}
  class="fixed inset-0 bg-black bg-opacity-90 z-[100] hidden flex items-center justify-center p-4 transition-opacity duration-300 opacity-0 pointer-events-none"
>
  <div
    id={contentId}
    class="relative max-w-4xl w-full transform transition-transform duration-300 scale-95"
  >
    <button
      onclick={`closeLightbox('${id}')`}
      class="absolute -top-12 right-0 text-white hover:text-gray-300 transition-colors p-2 rounded-full hover:bg-white/10"
      aria-label="Close"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="bg-white rounded-xl shadow-2xl overflow-hidden">
      <div id={titleId} class="px-6 py-4 bg-gray-50 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900"></h3>
      </div>
      <div class="p-4">
        <img
          id={imageId}
          src=""
          alt="Lightbox image"
          class="w-full h-auto max-h-[70vh] object-contain rounded-lg"
        />
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  /**
   * Opens the lightbox with an image
   * @param {string} lightboxId - The lightbox ID to open
   * @param {string} imageUrl - URL of the image to display
   * @param {string} title - Title to display (optional)
   */
  window.openLightbox = function (lightboxId, imageUrl, title = '') {
    const container = document.getElementById(`${lightboxId}-container`);
    const content = document.getElementById(`${lightboxId}-content`);
    const img = document.getElementById(`${lightboxId}-image`);
    const titleEl = document.getElementById(`${lightboxId}-title`);

    if (!container || !img) return;

    img.src = imageUrl;
    if (titleEl) {
      titleEl.querySelector('h3').textContent = title;
      titleEl.style.display = title ? 'block' : 'none';
    }

    container.classList.remove('hidden');
    setTimeout(() => {
      container.classList.remove('opacity-0', 'pointer-events-none');
      content.classList.remove('scale-95');
      content.classList.add('scale-100');
    }, 10);

    document.body.style.overflow = 'hidden';
  };

  /**
   * Closes the lightbox
   * @param {string} lightboxId - The lightbox ID to close
   */
  window.closeLightbox = function (lightboxId) {
    const container = document.getElementById(`${lightboxId}-container`);
    const content = document.getElementById(`${lightboxId}-content`);

    if (!container) return;

    container.classList.add('opacity-0', 'pointer-events-none');
    content.classList.remove('scale-100');
    content.classList.add('scale-95');

    setTimeout(() => {
      container.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  };

  // Close on outside click
  document.getElementById(`${id}-container`)?.addEventListener('click', (e) => {
    if (e.target.id === `${id}-container`) {
      window.closeLightbox(id);
    }
  });

  // Close on escape key - use single global listener with event delegation
  if (!window.lightboxEscapeListenerAdded) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        // Find all open lightboxes and close them
        const openLightboxes = document.querySelectorAll('[id$="-container"]:not(.hidden)');
        openLightboxes.forEach((container) => {
          const lightboxId = container.id.replace('-container', '');
          if (typeof window.closeLightbox === 'function') {
            window.closeLightbox(lightboxId);
          }
        });
      }
    });
    window.lightboxEscapeListenerAdded = true;
  }
</script>
