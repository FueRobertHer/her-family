---
// Reusable lightbox component for displaying images
interface Props {
  id?: string; // Unique ID for this lightbox instance (default: 'lightbox')
}

const { id = 'lightbox' } = Astro.props;
const containerId = `${id}-container`;
const contentId = `${id}-content`;
const imageId = `${id}-image`;
const titleId = `${id}-title`;
---

<div
  id={containerId}
  data-lightbox-root={id}
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  class="fixed inset-0 bg-black/90 z-100 hidden flex items-center justify-center p-4 transition-opacity duration-300 opacity-0 pointer-events-none"
>
  <div
    id={contentId}
    class="relative max-w-4xl w-full transform transition-transform duration-300 scale-95"
  >
    <button
      type="button"
      data-lightbox-close={id}
      class="absolute -top-12 right-0 text-white hover:text-gray-300 transition-colors p-2 rounded-full hover:bg-white/10"
      aria-label="Close"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="bg-white rounded-xl shadow-2xl overflow-hidden">
      <!--
        Hidden until a title is set. An always-present empty heading is
        reported as an empty-heading violation by screen readers and audits.
      -->
      <div
        id={titleId}
        class="px-6 py-4 bg-gray-50 border-b border-gray-200"
        style="display: none;"
      >
        <h3 class="text-lg font-semibold text-gray-900"></h3>
      </div>
      <div class="p-4">
        <img
          id={imageId}
          src=""
          alt="Lightbox image"
          class="w-full h-auto max-h-[70vh] object-contain rounded-lg"
        />
      </div>
    </div>
  </div>
</div>

<script>
  import '../scripts/lightbox.ts';
</script>
