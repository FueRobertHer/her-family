---
export interface Props {
  content: string;
  title: string;
  highlights?: string[];
  highlightsVisible?: boolean;
  isAdmin?: boolean;
}

const { content, title, highlights = [], highlightsVisible = true, isAdmin = false } = Astro.props;
---

<section id="biography" class="py-16 sm:py-24 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2
        class="font-display text-3xl sm:text-4xl font-bold text-warm-gray-900 mb-4"
        data-bio-title
      >
        {title}
      </h2>
      <div class="w-24 h-1 bg-warm-gray-300 mx-auto"></div>
    </div>

    <div class="prose prose-lg prose-warm-gray max-w-none">
      <div id="bio-container" class="relative">
        <div
          id="bio-content"
          class="text-warm-gray-700 leading-relaxed text-lg overflow-hidden transition-all duration-500 ease-in-out"
          data-bio-content
          style="max-height: 400px;"
        >
          {content.split('\n\n').map((paragraph) => <p class="mb-6">{paragraph}</p>)}
        </div>
        <div
          id="bio-fade"
          class="absolute bottom-0 left-0 right-0 h-32 bg-linear-to-t from-white via-white/80 to-transparent pointer-events-none transition-opacity duration-500"
        >
        </div>
      </div>
      <div class="text-center mt-8">
        <button
          id="bio-toggle"
          class="group inline-flex items-center gap-2 text-warm-gray-600 hover:text-warm-gray-900 font-display text-base transition-all duration-300 relative after:absolute after:bottom-0 after:left-0 after:right-0 after:h-px after:bg-warm-gray-300 after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300 pb-1"
          style="display: none;"
        >
          <span id="bio-toggle-text" class="font-medium">Continue Reading</span>
          <svg
            id="bio-chevron-down"
            class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
            ></path>
          </svg>
          <svg
            id="bio-chevron-up"
            class="hidden w-4 h-4 transition-transform duration-300 group-hover:-translate-y-0.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    {
      highlights.length > 0 && (highlightsVisible || isAdmin) && (
        <div
          class={`mt-12 bg-warm-gray-50 rounded-lg p-8 relative ${!highlightsVisible && isAdmin ? 'opacity-60 border-2 border-dashed border-gray-300' : ''}`}
        >
          {!highlightsVisible && isAdmin && (
            <span class="hidden-badge absolute top-3 left-3 text-xs bg-gray-200 text-gray-600 px-2 py-1 rounded-sm">
              Hidden
            </span>
          )}
          <h3 class="font-display text-2xl font-semibold text-warm-gray-900 mb-6 text-center">
            Cherished Memories
          </h3>
          <div class="grid md:grid-cols-2 gap-6" data-bio-highlights>
            {highlights.map((highlight) => (
              <div class="flex items-start space-x-3">
                <div class="shrink-0 w-2 h-2 bg-warm-gray-400 rounded-full mt-3" />
                <p class="text-warm-gray-700">{highlight}</p>
              </div>
            ))}
          </div>
          {isAdmin && (
            <button
              type="button"
              data-edit-section="highlights"
              class="absolute top-4 right-4 bg-white hover:bg-warm-gray-100 text-indigo-600 px-3 py-2 rounded-lg shadow-md text-sm font-medium transition-all edit-button"
            >
              ✏️ Edit
            </button>
          )}
        </div>
      )
    }
  </div>
</section>

<script>
  import '../scripts/biography.ts';
</script>
