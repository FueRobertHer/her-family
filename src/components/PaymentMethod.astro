---
interface Props {
  name: 'Venmo' | 'Cash App' | 'Zelle';
  username?: string;
  qrImage?: string;
  dataPrefix: string;
  hoverColor: string;
  icon: 'venmo' | 'cashapp' | 'zelle';
}

const { name, username, qrImage, dataPrefix, hoverColor, icon } = Astro.props;

// replace @ and $ with nothing
const cleanUsername = username?.replace(/@/g, '').replace(/\$/g, '');

const getUrl = () => {
  if (name === 'Venmo') return `https://venmo.com/${cleanUsername}`;
  if (name === 'Cash App') return `https://cash.app/${cleanUsername}`;
  return '#';
};

const getIconViewBox = () => {
  // Cash App SVG is designed for 24x24, others are 48x48
  if (icon === 'cashapp') return '0 0 24 24';
  return '0 0 48 48';
};

const getIconSvg = () => {
  if (icon === 'venmo') {
    return `<path fill="#008CFF" d="M35,42H13c-3.866,0-7-3.134-7-7V13c0-3.866,3.134-7,7-7h22c3.866,0,7,3.134,7,7v22C42,38.866,38.866,42,35,42z"/>
            <path fill="#fff" d="M26.1,36.3h-9.7l-3.9-23.2l8.5-0.8l2.1,16.5c1.9-3.1,4.3-8,4.3-11.4c0-1.8-0.3-3.1-0.8-4.1l8.3-1.8c0.9,1.5,1.3,3,1.3,4.9C35.4,22.6,30.3,30.5,26.1,36.3z"/>`;
  }
  if (icon === 'cashapp') {
    return `<path fill="#00D632" d="M23.59 3.475a5.1 5.1 0 0 0-3.05-3.05c-1.31-.42-2.5-.42-4.92-.42H8.36c-2.4 0-3.61 0-4.9.4a5.1 5.1 0 0 0-3.05 3.06C0 4.765 0 5.965 0 8.365v7.27c0 2.41 0 3.6.4 4.9a5.1 5.1 0 0 0 3.05 3.05c1.3.41 2.5.41 4.9.41h7.28c2.41 0 3.61 0 4.9-.4a5.1 5.1 0 0 0 3.06-3.06c.41-1.3.41-2.5.41-4.9v-7.25c0-2.41 0-3.61-.41-4.91zm-6.17 4.63-.93.93a.5.5 0 0 1-.67.01 5 5 0 0 0-3.22-1.18c-.97 0-1.94.32-1.94 1.21 0 .9 1.04 1.2 2.24 1.65 2.1.7 3.84 1.58 3.84 3.64 0 2.24-1.74 3.78-4.58 3.95l-.26 1.2a.49.49 0 0 1-.48.39H9.63l-.09-.01a.5.5 0 0 1-.38-.59l.28-1.27a6.54 6.54 0 0 1-2.88-1.57v-.01a.48.48 0 0 1 0-.68l1-.97a.49.49 0 0 1 .67 0c.91.86 2.13 1.34 3.39 1.32 1.3 0 2.17-.55 2.17-1.42 0-.87-.88-1.1-2.54-1.72-1.76-.63-3.43-1.52-3.43-3.6 0-2.42 2.01-3.6 4.39-3.71l.25-1.23a.48.48 0 0 1 .48-.38h1.78l.1.01c.26.06.43.31.37.57l-.27 1.37c.9.3 1.75.77 2.48 1.39l.02.02c.19.2.19.5 0 .68z"/>`;
  }
  // Zelle
  return `<path fill="#a0f" d="M35,42H13c-3.866,0-7-3.134-7-7V13c0-3.866,3.134-7,7-7h22c3.866,0,7,3.134,7,7v22C42,38.866,38.866,42,35,42z"/>
          <path fill="#fff" d="M17.5,18.5h14c0.552,0,1-0.448,1-1V15c0-0.552-0.448-1-1-1h-14c-0.552,0-1,0.448-1,1v2.5C16.5,18.052,16.948,18.5,17.5,18.5z"/>
          <path fill="#fff" d="M17,34.5h14.5c0.552,0,1-0.448,1-1V31c0-0.552-0.448-1-1-1H17c-0.552,0-1,0.448-1,1v2.5C16,34.052,16.448,34.5,17,34.5z"/>
          <path fill="#fff" d="M22.25,11v6c0,0.276,0.224,0.5,0.5,0.5h3.5c0.276,0,0.5-0.224,0.5-0.5v-6c0-0.276-0.224-0.5-0.5-0.5h-3.5C22.474,10.5,22.25,10.724,22.25,11z"/>
          <path fill="#fff" d="M22.25,32v6c0,0.276,0.224,0.5,0.5,0.5h3.5c0.276,0,0.5-0.224,0.5-0.5v-6c0-0.276-0.224-0.5-0.5-0.5h-3.5C22.474,31.5,22.25,31.724,22.25,32z"/>
          <path fill="#fff" d="M16.578,30.938H22l10.294-12.839c0.178-0.222,0.019-0.552-0.266-0.552H26.5L16.275,30.298C16.065,30.553,16.247,30.938,16.578,30.938z"/>`;
};

// Get the full button/link classes based on hover color
const getBtnClasses = () => {
  const base =
    'flex items-center p-6 border-2 border-warm-gray-200 rounded-lg hover:shadow-md transition-all duration-300 group-hover:scale-105 h-32';
  if (hoverColor === 'blue-400') return `${base} hover:border-blue-400 w-full text-left`;
  if (hoverColor === 'green-500') return `${base} hover:border-green-500 w-full text-left`;
  if (hoverColor === 'purple-500') return `${base} hover:border-purple-500 w-full text-left`;
  return `${base} w-full text-left`;
};

const getLinkClasses = () => {
  const base =
    'flex items-center p-6 border-2 border-warm-gray-200 rounded-lg hover:shadow-md transition-all duration-300 group-hover:scale-105 h-32';
  if (hoverColor === 'blue-400') return `${base} hover:border-blue-400`;
  if (hoverColor === 'green-500') return `${base} hover:border-green-500`;
  if (hoverColor === 'purple-500') return `${base} hover:border-purple-500`;
  return base;
};

const getTextColorClass = () => {
  if (hoverColor === 'blue-400') return 'text-xs text-blue-500';
  if (hoverColor === 'green-500') return 'text-xs text-green-500';
  if (hoverColor === 'purple-500') return 'text-xs text-purple-500';
  return 'text-xs';
};

const getIconColorClass = () => {
  const base = 'w-5 h-5 text-warm-gray-400 transition-colors';
  if (hoverColor === 'blue-400') return `${base} group-hover:text-blue-500`;
  if (hoverColor === 'green-500') return `${base} group-hover:text-green-500`;
  if (hoverColor === 'purple-500') return `${base} group-hover:text-purple-500`;
  return base;
};

const iconClass =
  icon === 'cashapp'
    ? 'shrink-0 w-16 h-16 flex items-center justify-center mr-4 bg-white rounded-lg p-2'
    : 'shrink-0 w-16 h-16 flex items-center justify-center mr-4';

// Generate dynamic data attributes
const containerAttrs = { [`data-${dataPrefix}-container`]: '' };
const btnAttrs = { [`data-${dataPrefix}-btn`]: '' };
const linkAttrs = { [`data-${dataPrefix}-link`]: '' };
const usernameAttrs = { [`data-${dataPrefix}-username`]: '' };
const emailAttrs = { [`data-${dataPrefix}-email`]: '' };
---

<div
  class={`donation-option group w-full sm:w-[calc(50%-0.75rem)] ${!username ? 'hidden' : ''}`}
  {...containerAttrs}
>
  {
    qrImage ? (
      <button
        type="button"
        onclick={`openPaymentLightbox('${qrImage}', '${name} QR Code')`}
        class={getBtnClasses()}
        {...btnAttrs}
      >
        <div class={iconClass}>
          <svg class="w-full h-full" viewBox={getIconViewBox()} set:html={getIconSvg()} />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-warm-gray-900 mb-1">{name}</h3>
          <p class="text-warm-gray-600 truncate mb-1" {...usernameAttrs}>
            {username}
          </p>
          <p class={getTextColorClass()}>Click to view QR Code</p>
        </div>
      </button>
    ) : name === 'Zelle' ? (
      <div class="flex items-center p-6 border-2 border-warm-gray-200 rounded-lg h-32">
        <div class="shrink-0 w-16 h-16 flex items-center justify-center mr-4">
          <svg class="w-full h-full" viewBox={getIconViewBox()} set:html={getIconSvg()} />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-warm-gray-900 mb-1">{name}</h3>
          <p class="text-warm-gray-600 truncate mb-1" {...emailAttrs}>
            {username !== undefined ? username : 'email@example.com'}
          </p>
          <p class="text-sm text-warm-gray-500">Send via your banking app</p>
        </div>
      </div>
    ) : (
      <a
        href={getUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class={getLinkClasses()}
        {...linkAttrs}
      >
        <div class={iconClass}>
          <svg class="w-full h-full" viewBox={getIconViewBox()} set:html={getIconSvg()} />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-warm-gray-900 mb-1">{name}</h3>
          <p class="text-warm-gray-600 truncate mb-1" {...usernameAttrs}>
            {username !== undefined ? username : name === 'Venmo' ? '@username' : '$username'}
          </p>
          <p class="text-sm text-transparent select-none">Spacer</p>
        </div>
        <svg class={getIconColorClass()} fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          />
        </svg>
      </a>
    )
  }
</div>
