---
/**
 * Admin-only edit button: shared pencil icon, shared type, shared shape.
 *
 * Every edit affordance on the memorial page routes through here so they cannot
 * drift apart again. The colour `variant` exists because these sit on different
 * surfaces (white cards, the blue and green notice panels, the dark reception
 * banner), not because the buttons are different kinds of thing.
 */
import PencilIcon from './PencilIcon.astro';

export interface Props {
  /** Section name passed to openEditModal */
  section: string;
  /** Visible label, e.g. "Edit Hero" */
  label?: string;
  /** Positioning classes. Pass "" for a button that sits in normal flow. */
  positionClass?: string;
  /** Colour treatment for the surface the button sits on. */
  variant?: 'default' | 'blue' | 'green' | 'onDark';
  /** Extra utilities, e.g. reveal-on-hover. */
  class?: string;
}

const VARIANTS = {
  default: 'bg-white/90 hover:bg-white text-indigo-600',
  blue: 'bg-white hover:bg-blue-100 text-blue-600',
  green: 'bg-white hover:bg-green-100 text-green-600',
  onDark: 'bg-white/20 hover:bg-white/30 text-white',
};

const {
  section,
  label = 'Edit',
  positionClass = 'absolute top-8 right-8',
  variant = 'default',
  class: className = '',
} = Astro.props;
---

<button
  type="button"
  data-edit-section={section}
  class:list={[
    positionClass,
    VARIANTS[variant],
    className,
    'inline-flex items-center gap-1.5 px-3 py-2 rounded-lg shadow-md text-sm font-medium transition-all edit-button',
  ]}
>
  <PencilIcon />
  {label}
</button>
