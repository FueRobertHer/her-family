---
/**
 * Admin-only floating edit button with an SVG pencil icon.
 * Replaces the seven duplicated emoji (✏️) buttons on the memorial page.
 */
export interface Props {
  /** Section name passed to openEditModal */
  section: string;
  /** Visible label, e.g. "Edit Hero" */
  label: string;
  /** Positioning classes (defaults to the common top-right placement) */
  positionClass?: string;
}

const { section, label, positionClass = 'absolute top-8 right-8' } = Astro.props;
---

<button
  type="button"
  data-edit-section={section}
  class={`${positionClass} inline-flex items-center gap-1.5 bg-white/90 hover:bg-white text-indigo-600 px-3 py-2 rounded-lg shadow-md text-sm font-medium transition-all edit-button`}
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
    ></path>
  </svg>
  {label}
</button>
